rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if user is admin via custom claims or Firestore role
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper function for content type and size validation
    function isImageUnder(maxSize) {
      return request.resource != null &&
        request.resource.size <= maxSize &&
        request.resource.contentType.matches('image/.*');
    }

    // 1. Product Images: Publicly readable storefront assets; admin upload/delete only (max 10MB)
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.resource == null || isImageUnder(10 * 1024 * 1024));
    }

    // 2. User Avatars / Profile Images: Publicly readable, owner upload only (max 5MB image)
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId && (request.resource == null || isImageUnder(5 * 1024 * 1024));
    }

    // Default: Deny arbitrary uploads and restrict reading unclassified paths to admin
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}

