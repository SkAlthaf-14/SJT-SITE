# Keep only client-safe keys and public identifiers here.
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://sjtfarms.com
VITE_BUSINESS_NOTIFICATION_EMAIL=Alterit2026@gmail.com

# Firebase Client Web SDK (sjtfarms-5eaeb)
VITE_FIREBASE_API_KEY=AIzaSyCO30dNxp6Ax0kn5vMCwnMw2Jsfr0LmiCE
VITE_FIREBASE_AUTH_DOMAIN=sjtfarms-5eaeb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sjtfarms-5eaeb
