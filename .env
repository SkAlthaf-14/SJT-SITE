VITE_FIREBASE_MESSAGING_SENDER_ID=732402317142
VITE_FIREBASE_APP_ID=1:732402317142:web:c115fe066a50c73e8d08f7
VITE_FIREBASE_MEASUREMENT_ID=G-ZGZB3DL3T9

# WhatsApp Direct Contact (Click-to-Chat)
VITE_WHATSAPP_PHONE_NUMBER=918121020111
VITE_WHATSAPP_DISPLAY_PHONE=+91 81210 20111

# Payment Gateway - Public Key (Optional: for Razorpay Checkout Modal)
# Get from Razorpay Dashboard -> Settings -> API Keys (Key ID starts with rzp_live_ or rzp_test_)
VITE_RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE ONLY: PAYMENT GATEWAY (Razorpay / Cashfree / Stripe)
# ------------------------------------------------------------------------------
# SECURITY: Never expose secret keys or webhook secrets to frontend code.
# Used inside Firebase Cloud Functions or secure API routes.
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_PROVIDER=Razorpay
PAYMENT_GATEWAY_KEY_ID=YOUR_RAZORPAY_KEY_ID_HERE
PAYMENT_GATEWAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET_HERE
PAYMENT_WEBHOOK_SECRET=YOUR_PAYMENT_WEBHOOK_SECRET_HERE

# ------------------------------------------------------------------------------
# 3. SERVER-SIDE ONLY: EMAIL NOTIFICATION SERVICE (Resend / SendGrid / SES)
# ------------------------------------------------------------------------------
# Used by backend to send order notifications to customer & Alterit2026@gmail.com
# Provider recommendation: Resend (https://resend.com) or SendGrid (https://sendgrid.com)
# ------------------------------------------------------------------------------
EMAIL_SERVICE_PROVIDER=Resend
EMAIL_SERVICE_API_KEY=YOUR_EMAIL_SERVICE_API_KEY_HERE
EMAIL_FROM_ADDRESS="SJT Farms Orders <orders@sjtfarms.com>"
EMAIL_NOTIFICATION_DESTINATION="Alterit2026@gmail.com"

# ------------------------------------------------------------------------------
# 4. SERVER-SIDE ONLY: META WHATSAPP BUSINESS CLOUD API
# ------------------------------------------------------------------------------
# Setup guide available at: docs/WHATSAPP_CLOUD_API_SETUP.md
# Obtain credentials from: https://developers.facebook.com -> WhatsApp -> API Setup
# ------------------------------------------------------------------------------
META_GRAPH_API_VERSION=v21.0
META_APP_ID=YOUR_META_APP_ID_HERE
META_APP_SECRET=YOUR_META_APP_SECRET_HERE
META_WA_BUSINESS_ACCOUNT_ID=YOUR_WABA_ACCOUNT_ID_HERE
