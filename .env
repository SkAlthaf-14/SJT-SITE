META_WA_WEBHOOK_VERIFY_TOKEN=YOUR_CUSTOM_SECURE_RANDOM_VERIFY_TOKEN_HERE

# ------------------------------------------------------------------------------
# 5. SERVER-SIDE ONLY: MICROSOFT GRAPH API & EXCEL ONLINE INTEGRATION
# ------------------------------------------------------------------------------
# Automatically syncs orders, customers, and payments to OneDrive / SharePoint Excel
# Obtain from: https://portal.azure.com -> App registrations
# ------------------------------------------------------------------------------
MICROSOFT_TENANT_ID=YOUR_AZURE_AD_TENANT_ID_HERE
MICROSOFT_CLIENT_ID=YOUR_AZURE_AD_APP_CLIENT_ID_HERE
MICROSOFT_CLIENT_SECRET=YOUR_AZURE_AD_CLIENT_SECRET_HERE
EXCEL_WORKBOOK_ID=YOUR_ONEDRIVE_OR_SHAREPOINT_WORKBOOK_ID_HERE
EXCEL_DRIVE_ID=YOUR_ONEDRIVE_DRIVE_ID_HERE