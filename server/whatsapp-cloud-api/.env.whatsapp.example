# ==============================================================================
# SJT FARMS — WhatsApp Business Cloud API Server Environment Configuration
# ==============================================================================
# SECURITY NOTICE:
# - This file is an example template containing placeholders ONLY.
# - DO NOT add actual tokens or secrets here or commit them to Git.
# - In production or serverless runtimes (Firebase Cloud Functions, Google Cloud Run,
#   AWS Lambda, or VPS), configure these via your secure Secret Manager.
# ==============================================================================

# Meta WhatsApp Cloud API Version (v21.0 recommended)
META_GRAPH_API_VERSION=v21.0

# Meta Developer App Credentials (from developers.facebook.com)
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET

# WhatsApp Business Account & Phone Number Identifiers
# (Found in Meta App Dashboard -> WhatsApp -> API Setup)
META_WA_BUSINESS_ACCOUNT_ID=YOUR_WABA_ACCOUNT_ID
META_WA_PHONE_NUMBER_ID=YOUR_WA_PHONE_NUMBER_ID

# Permanent System User Access Token with 'whatsapp_business_messaging' and 'whatsapp_business_management'
META_WA_ACCESS_TOKEN=YOUR_PERMANENT_SYSTEM_USER_ACCESS_TOKEN

# Webhook Verification Secret Token (Must match the Verify Token entered in Meta Webhook Configuration)
META_WA_WEBHOOK_VERIFY_TOKEN=YOUR_CUSTOM_SECURE_RANDOM_VERIFY_TOKEN

# Canonical Production Store URL (Used in outbound messages & tracking links)
CANONICAL_STORE_URL=https://sjtfarms.com
